{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kodkigyo",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // Az index.html-t a build lépés másolja a public/ mappába, a biztonsági fejlécekkel együtt.
  "build": { "command": "node scripts/prepare.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Ne legyen minden verziónak külön nyilvános címe, csak az éles oldal.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kodkigyo",
      // EU-s joghatósággal létrehozott adatbázis (npx wrangler d1 create kodkigyo --jurisdiction=eu).
      "database_id": "b6fcbe54-e772-4786-a0b3-0f797df83a5e",
      "migrations_dir": "migrations"
    }
  ],
  // Az üzemeltető fiókazonosítója(i) vesszővel elválasztva: nekik az app tesztpanelt mutat (Profil › Teszt).
  "vars": { "ADMIN_IDS": "54Z52J8H" },
  // Óránként lezárja a véget ért heti ligacsoportokat, és törli a lejárt adatokat.
  "triggers": { "crons": ["7 * * * *"] }
  // Saját domainhez (miután a kodkigyo.hu a Cloudflare-en van), vedd ki a megjegyzésből:
  // , "routes": [{ "pattern": "kodkigyo.hu", "custom_domain": true }]
}
