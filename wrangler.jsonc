{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kodkigyo",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // Az index.html-t a build lépés másolja a public/ mappába, a biztonsági fejlécekkel együtt.
  "build": { "command": "node scripts/prepare.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Ne legyen minden verziónak külön nyilvános címe, csak az éles oldal.
  "preview_urls": false,
  // A régi kodkigyo.<fiók>.workers.dev cím is működjön tovább, amíg mindenki átszokik a kodkigyo.hu-ra.
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kodkigyo",
      // EU-s joghatósággal létrehozott adatbázis (npx wrangler d1 create kodkigyo --jurisdiction=eu).
      "database_id": "b6fcbe54-e772-4786-a0b3-0f797df83a5e",
      "migrations_dir": "migrations"
    }
  ],
  // ADMIN_IDS: az üzemeltető fiókazonosítója(i) vesszővel elválasztva; nekik az app tesztpanelt mutat (Profil › Teszt).
  // TURNSTILE_SITEKEY: a Cloudflare Turnstile robotszűrő nyilvános kulcsa. A titkos kulcs TURNSTILE_SECRET néven,
  // titkosított változóként (Secret) a Worker beállításaiban van. A robotszűrő csak akkor él, ha mindkettő meg van adva.
  "vars": { "ADMIN_IDS": "54Z52J8H", "TURNSTILE_SITEKEY": "0x4AAAAAAFOrNsRdAO_1Tvxi" },
  // Óránként lezárja a véget ért heti ligacsoportokat, és törli a lejárt adatokat.
  "triggers": { "crons": ["7 * * * *"] },
  // Saját domain: a Cloudflare a DNS-rekordokat és a tanúsítványt magától létrehozza hozzá.
  "routes": [
    { "pattern": "kodkigyo.hu", "custom_domain": true },
    { "pattern": "www.kodkigyo.hu", "custom_domain": true }
  ]
}
